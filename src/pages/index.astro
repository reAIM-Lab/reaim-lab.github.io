---
import Layout from "../layouts/Layout.astro";

const news = [
	{
		date: "June 2026",
		title: "FAccT Best Paper Award",
		content:
			'Apara and Sara\'s paper "A pipeline for enabling path-specific causal fairness in observational health data" received a <a href="https://facct-blog.github.io/2026-06-25/best-papers" class="font-bold text-reaim-blue hover:underline">Best Paper Award</a> at the 2026 ACM Conference on Fairness, Accountability, and Transparency (FAccT). Congratulations!'
	},
	{
		date: "June 2025",
		title: "Google Research Scholar Award",
		content:
			`Shalmali Joshi is grateful for support from the <a href="https://research.google/programs-and-events/research-scholar-program/recipients/" class="font-bold text-reaim-blue hover:underline">Google Research Scholar Program</a>!`
	},
	{
		date: "May 2025",
		badge: "New Preprint!",
		title: "Benchmarking EHR Foundation Models",
		content:
			`We benchmarked SOTA structured EHR foundation models on Columbia University Medical Center data. Read more about 'FoMoH' <a href="https://arxiv.org/abs/2505.16941" class="font-bold text-reaim-blue hover:underline">here</a>!`
	}
];
---

<Layout title="Home">
	<section class="home-hero -mt-28 flex min-h-svh items-center py-28">
		<div class="w-full">
			<h1
				class="mb-10 max-w-4xl text-4xl leading-[1.1] font-bold tracking-tight text-black sm:text-5xl md:text-5xl"
			>
				We are the <br class="hidden md:block" />
				<span class="text-reaim-blue">re</span>liable
				<span class="text-reaim-blue">A</span>rtificial
				<span class="text-reaim-blue">I</span>ntelligence <br class="hidden md:block" />
				for Health and
				<span class="text-reaim-blue">M</span>edicine Lab.
			</h1>

			<div
				class="grid items-start gap-10 lg:grid-cols-[minmax(0,42rem)_14rem] lg:gap-12"
			>
				<div class="max-w-2xl">
					<p class="mb-8 text-lg leading-relaxed font-light text-gray-800 md:text-lg">
						Led by <a
							href="/shalmalijoshi"
							class="border-reaim-blue hover:text-reaim-blue border-b-2 font-bold text-black transition-colors"
							>Dr. Shalmali Joshi</a
						> in the
						<a
							href="https://www.dbmi.columbia.edu/"
							class="hover:text-reaim-blue font-medium text-gray-900"
							>Department of Biomedical Informatics (DBMI)</a
						> at Columbia University in the City of New York.
					</p>

					<p class="text-lg leading-relaxed text-gray-800 md:text-lg">
						Our vision is to design AI and ML systems to improve scientific inference and predictive
						capabilities in the biomedical sciences, discovery, and informatics, focused on challenges
						of <span class="font-semibold text-black"
							>generalizability, reliability, and robustness</span
						> of inference and prediction. We develop methods that cut across deep learning,
						reinforcement learning, observational causal inference, and probabilistic modeling.
					</p>
				</div>

				<nav
					class="flex w-full flex-col items-start lg:max-w-56"
					aria-label="Explore the reAIM Lab"
				>
					{
						[
							{ href: "/research", label: "Research" },
							{ href: "/publications", label: "Publications" },
							{ href: "/teaching", label: "Teaching" },
							{ href: "/group", label: "Group" },
							{ href: "/join", label: "Join Us" }
						].map((link) => (
							<a
								href={link.href}
								class="group text-reaim-dark hover:text-reaim-blue focus-visible:ring-reaim-blue inline-flex min-h-10 items-center gap-2 text-xl font-bold transition-colors focus:outline-none focus-visible:ring-2 lg:text-2xl"
							>
								<span>{link.label}</span>
								<span
									class="transition-transform duration-200 group-hover:translate-x-1"
									aria-hidden="true">&rarr;</span
								>
							</a>
						))
					}
				</nav>
			</div>
		</div>
	</section>

	<section class="home-news reveal mb-24">
		<div class="mb-8 flex items-center">
			<h2 class="mr-4 text-2xl font-bold tracking-wide text-black uppercase md:text-2xl">News</h2>
			<div class="h-1 flex-1 rounded-full bg-gray-100"></div>
		</div>

		<div class="space-y-8">
			{
				news.map((item) => (
					<div class="flex flex-col items-start gap-4 md:flex-row md:gap-8">
						<div class="w-32 shrink-0">
							<span class="text-sm font-bold tracking-wider text-gray-400 uppercase">
								{item.date}
							</span>
						</div>
						<div class="flex-1">
							{item.badge && (
								<span class="bg-reaim-blue/10 text-reaim-blue mb-2 inline-block rounded px-2 py-1 text-xs font-bold tracking-wide uppercase">
									{item.badge}
								</span>
							)}
							<h3 class="mb-2 text-lg font-bold text-black md:text-lg">{item.title}</h3>
							<p class="text-lg text-gray-800 md:text-lg" set:html={item.content} />
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="home-support reveal mb-20 pt-12">
		<p class="mb-8 text-center text-sm font-bold tracking-widest text-gray-400 uppercase">
			We are grateful for support from
		</p>
		<div
			class="flex flex-wrap items-center justify-center gap-8 opacity-70 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 md:gap-16"
		>
			<a
				href="https://www.vagelos.columbia.edu/departments-centers/centers-and-institutes/stavros-niarchos-foundation-center-precision-psychiatry-mental-health"
				class="text-reaim-dark hover:text-reaim-blue max-w-[200px] text-center text-lg font-bold md:text-lg"
			>
				SNF Center for Precision Psychiatry
			</a>
			<a
				href="https://research.google/programs-and-events/research-scholar-program/recipients/"
				class="text-xl font-bold text-gray-800 hover:text-blue-500 md:text-xl">Google</a
			>
			<a
				href="https://www.nimh.nih.gov/"
				class="text-xl font-bold text-gray-800 hover:text-blue-700 md:text-xl">NIMH</a
			>
			<a
				href="https://www.nlm.nih.gov/"
				class="text-xl font-bold text-gray-800 hover:text-blue-600 md:text-xl">NLM</a
			>
		</div>
	</section>
</Layout>

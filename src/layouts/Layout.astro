---
import "../styles/global.css";
const { title, description } = Astro.props;

const currentYear = new Date().getFullYear();

const pageTitle = `${title} | reAIM Lab`;
const metaDescription =
	description ||
	"The reAIM Lab at Columbia University, led by Prof. Shalmali Joshi, focuses on Trustworthy Machine Learning for Healthcare.";

// Link previews and canonical tags need absolute URLs; `site` in
// astro.config.mjs supplies the origin. build.format "file" leaves a .html
// suffix on the pathname, but every link on the site (and so every URL that
// gets shared) uses the extensionless form — canonicalise on that.
const canonicalPath = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "");
const canonicalUrl = new URL(canonicalPath || "/", Astro.site);
const socialImage = new URL("/images/og-card.jpg", Astro.site);
const currentPath = canonicalPath.replace(/\/$/, "") || "/";
const navLinks = [
	{ href: "/shalmalijoshi", label: "Shalmali Joshi" },
	{ href: "/research", label: "Research" },
	{ href: "/publications", label: "Publications" },
	{ href: "/teaching", label: "Teaching" },
	{ href: "/group", label: "Group" },
	{ href: "/join", label: "Join Us!" }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta name="robots" content="noarchive" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="reAIM Lab" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Members of the reAIM Lab gathered around a table" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={socialImage} />
		<script is:inline>
			// Runs synchronously before paint so scroll-reveal elements start hidden
			// only when JS is available (content stays visible if JS is off/fails).
			document.documentElement.classList.add("js-enabled");
		</script>
	</head>

	<body
		class="selection:bg-reaim-blue bg-reaim-bg font-sans text-lg text-gray-900 antialiased selection:text-white"
	>
		<a
			href="#main-content"
			class="sr-only transition-all focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:rounded-lg focus:bg-gray-900 focus:px-6 focus:py-3 focus:font-bold focus:text-white focus:shadow-xl"
		>
			Skip to main content
		</a>

		<div id="site-header" class="fixed inset-x-0 top-0 z-50 px-0 pt-0">
			<nav
				id="site-nav"
				class="mx-auto flex max-w-6xl items-center justify-between rounded-none border border-transparent bg-transparent px-4 py-5 md:px-6"
				aria-label="Main Navigation"
			>
				<a
					href="/"
					class="text-reaim-dark focus-visible:ring-reaim-blue rounded-sm text-xl font-bold tracking-tight focus:outline-none focus-visible:ring-2 md:text-3xl"
				>
					reAIM
				</a>

				<div
					class="hidden items-center space-x-6 text-lg font-medium text-gray-600 md:flex lg:space-x-8"
				>
					{
						navLinks.map((link) => (
							<a
								href={link.href}
								aria-current={currentPath === link.href ? "page" : undefined}
								class:list={[
									"hover:text-reaim-blue focus-visible:ring-reaim-blue transition-colors aria-[current=page]:font-bold focus:outline-none focus-visible:ring-2",
									{ "text-reaim-blue": link.href === "/join" }
								]}
							>
								{link.label}
							</a>
						))
					}
				</div>

				<button
					id="menu-btn"
					class="focus-visible:ring-reaim-blue relative block rounded-sm focus:outline-none focus-visible:ring-2 md:hidden"
					aria-label="Toggle Navigation Menu"
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<div class="space-y-2">
						<span
							id="line1"
							class="block h-0.5 w-8 origin-center bg-gray-600 transition-transform duration-300"
						></span>
						<span id="line2" class="block h-0.5 w-8 bg-gray-600 transition-opacity duration-300"
						></span>
						<span
							id="line3"
							class="block h-0.5 w-8 origin-center bg-gray-600 transition-transform duration-300"
						></span>
					</div>
				</button>
			</nav>
		</div>

		<div
			id="mobile-menu"
			class="fixed inset-0 z-40 flex translate-x-full items-center justify-center bg-white/95 backdrop-blur-xl transition-transform duration-300 md:hidden"
		>
			<div class="flex flex-col items-start space-y-8 text-2xl font-bold text-gray-800">
				<a href="/shalmalijoshi" class="hover:text-reaim-blue transition-colors">Shalmali Joshi</a>
				<a href="/research" class="hover:text-reaim-blue transition-colors">Research</a>
				<a href="/publications" class="hover:text-reaim-blue transition-colors">Publications</a>
				<a href="/teaching" class="hover:text-reaim-blue transition-colors">Teaching</a>
				<a href="/group" class="hover:text-reaim-blue transition-colors">Group</a>
				<a href="/join" class="text-reaim-blue transition-colors hover:underline">Join Us!</a>
			</div>
		</div>

		<main
			id="main-content"
			class="mx-auto min-h-screen max-w-6xl px-4 pt-28 pb-12 focus:outline-none md:px-8"
			tabindex="-1"
		>
			<slot />
		</main>

		<footer class="mt-24 py-12">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
				<div class="flex flex-col items-center justify-between gap-6 md:flex-row">
					<div class="text-sm font-medium tracking-tight text-gray-500">
						© {currentYear} reAIM Lab
					</div>

					<div class="flex flex-col items-center gap-6 md:flex-row md:gap-8">
						<nav
							class="flex flex-wrap justify-center gap-x-6 gap-y-3"
							aria-label="Footer Navigation"
						>
							<a
								href="/research"
								class="hover:text-reaim-blue rounded-sm text-sm font-bold text-gray-500 transition-colors"
								>Research</a
							>
							<a
								href="/publications"
								class="hover:text-reaim-blue rounded-sm text-sm font-bold text-gray-500 transition-colors"
								>Publications</a
							>
							<a
								href="/teaching"
								class="hover:text-reaim-blue rounded-sm text-sm font-bold text-gray-500 transition-colors"
								>Teaching</a
							>
							<a
								href="/group"
								class="hover:text-reaim-blue rounded-sm text-sm font-bold text-gray-500 transition-colors"
								>Group</a
							>
						</nav>

						<button
							id="back-to-top"
							aria-label="Scroll back to top of page"
							class="hover:text-reaim-blue flex items-center gap-1 rounded-sm px-2 py-1 text-sm font-bold tracking-wider text-gray-500 transition-colors"
						>
							Back to top <span aria-hidden="true">&uarr;</span>
						</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			const btn = document.getElementById("menu-btn");
			const menu = document.getElementById("mobile-menu");
			const line1 = document.getElementById("line1");
			const line2 = document.getElementById("line2");
			const line3 = document.getElementById("line3");
			let isMenuOpen = false;

			function toggleMenu() {
				if (!menu || !line1 || !line2 || !line3) return;
				isMenuOpen = !isMenuOpen;

				if (btn) btn.setAttribute("aria-expanded", isMenuOpen.toString());

				if (isMenuOpen) {
					menu.classList.remove("translate-x-full");
					document.body.style.overflow = "hidden";
					line1.classList.add("rotate-45", "translate-y-2.5");
					line2.classList.add("opacity-0");
					line3.classList.add("-rotate-45", "-translate-y-2.5");
				} else {
					menu.classList.add("translate-x-full");
					document.body.style.overflow = "";
					line1.classList.remove("rotate-45", "translate-y-2.5");
					line2.classList.remove("opacity-0");
					line3.classList.remove("-rotate-45", "-translate-y-2.5");
				}
			}

			if (btn) btn.addEventListener("click", toggleMenu);
			if (menu) {
				menu.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", () => {
						if (isMenuOpen) toggleMenu();
					});
				});
			}

			// The browser does not reliably perform the page-load jump to a URL
			// fragment here, which strands deep links (a publication author linking
			// to /group#yuta-kobayashi, or the join page's "jump to a role" links)
			// at the top of the page. Do the jump ourselves, honouring the target's
			// scroll-margin so it clears the fixed header.
			function scrollToHash() {
				if (!location.hash) return;
				let target: HTMLElement | null = null;
				try {
					target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
				} catch {
					return; // malformed percent-encoding in the hash
				}
				if (!target) return;

				// Land on a section that has already emerged rather than a blank one.
				target.closest(".reveal")?.classList.add("is-visible");

				const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
				window.scrollTo({
					top: target.getBoundingClientRect().top + window.scrollY - margin,
					behavior: "instant"
				});
			}

			if (location.hash) {
				scrollToHash();

				// Late-loading images or fonts can shift the target after the first
				// jump, so correct once more — unless the visitor is already scrolling.
				let userScrolled = false;
				const noteUserScroll = () => {
					userScrolled = true;
				};
				addEventListener("wheel", noteUserScroll, { passive: true, once: true });
				addEventListener("touchstart", noteUserScroll, { passive: true, once: true });
				addEventListener("keydown", noteUserScroll, { once: true });
				addEventListener(
					"load",
					() => {
						if (!userScrolled) scrollToHash();
					},
					{ once: true }
				);
			}

			// Enabled only after load so the jump above stays instant.
			window.addEventListener("load", () => {
				document.documentElement.classList.add("smooth-scroll");
			});

			const topBtn = document.getElementById("back-to-top");
			if (topBtn) {
				topBtn.addEventListener("click", () => {
					window.scrollTo({ top: 0, behavior: "smooth" });
				});
			}

			// Header morph: round/float the nav bar once the page is scrolled.
			const siteHeader = document.getElementById("site-header");
			if (siteHeader) {
				const onHeaderScroll = () => {
					siteHeader.classList.toggle("is-scrolled", window.scrollY > 8);
				};
				onHeaderScroll();
				window.addEventListener("scroll", onHeaderScroll, { passive: true });
			}

			// Scroll-reveal: fade/rise elements in as they enter the viewport (once).
			// The hidden state is CSS-gated on `.js-enabled` + no-reduced-motion, so
			// this only ever adds the "visible" state — content is never left hidden.
			const revealEls = document.querySelectorAll(".reveal");
			if (!("IntersectionObserver" in window)) {
				revealEls.forEach((el) => el.classList.add("is-visible"));
			} else {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15 }
				);
				revealEls.forEach((el) => revealObserver.observe(el));
			}
		</script>
	</body>
</html>
